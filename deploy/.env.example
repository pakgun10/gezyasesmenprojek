# Contoh environment untuk Penilaian Projek — salin menjadi .env di VPS
# (JANGAN commit file .env asli ke Git!)

# Port HTTP aplikasi (default 3023)
PORT=3023

# Folder database SQLite + upload foto.
# Biarkan dikomentari: di laptop otomatis pakai ./data; di VPS diisi otomatis
# oleh systemd (Environment=DATA_DIR di deploy/nilaiproyek.service).
# Hanya buka komentar & isi bila ingin lokasi data yang berbeda.
# DATA_DIR=/opt/nilaiproyek/data

# Password akun admin pertama (hanya dipakai saat DB masih kosong).
# Kalau dikosongkan, password acak dibuat & ditampilkan sekali di log.
ADMIN_PASSWORD=<redacted>

# 1 = cookie sesi hanya via HTTPS (wajib 1 di produksi di belakang nginx+TLS)
# 0 = boleh via HTTP (pengembangan lokal)
COOKIE_SECURE=1
