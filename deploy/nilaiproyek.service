[Unit]
Description=Penilaian Projek - aplikasi penilaian projek produk (Bun + Hono + SQLite)
After=network.target

[Service]
Type=simple
# Ganti USER_VPS dengan user Linux di VPS Pak Gun
User=USER_VPS
WorkingDirectory=/opt/nilaiproyek/gezymuse-nilai-projek
ExecStart=/home/USER_VPS/.bun/bin/bun run src/index.ts
Restart=always
RestartSec=5
Environment=PORT=3023
Environment=DATA_DIR=/opt/nilaiproyek/data
# Password admin diambil dari file .env (ADMIN_PASSWORD) — lihat deploy/DEPLOY.md.
# Sengaja TIDAK diset di sini agar nilai .env tidak tertimpa diam-diam.
Environment=COOKIE_SECURE=1

[Install]
WantedBy=multi-user.target
